# Copy to .env and fill in. Unset or empty values are treated as missing.

TZ=America/Buenos_Aires
# PORT=3000

# Required unless PROGRARR_AUTH=false. Used to log in from the browser and as
# the X-Api-Key header for API clients.
PROGRARR_API_KEY=
# Set to false to disable auth entirely (only on a network you trust)
# PROGRARR_AUTH=true

# Required services
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Download clients: configure at least one. A client is enabled when its URL is set.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# SABNZBD_URL=http://sabnzbd:8080
# SABNZBD_API_KEY=

# Optional: allow cross-origin API access from this origin (blocked when unset)
# CORS_ORIGIN=http://localhost:3000
